<Application x:Class="GhostAudioBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#07130F"/>
    <SolidColorBrush x:Key="Panel" Color="#10291D"/>
    <SolidColorBrush x:Key="Accent" Color="#4ADE80"/>
    <SolidColorBrush x:Key="TextMain" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A7C7B3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#24513B"/>
  </Application.Resources>
</Application>
